# CallDesk configuration
#
# Copy this file to `.env` and fill in what you need. With nothing filled in, CallDesk runs fully in
# mock mode: no API keys, no phone number, simulated calls only. `docker compose up` reads this file
# automatically; for `./mvnw spring-boot:run`, export the variables in your shell first
# (for example `set -a; source .env; set +a`).

# ---------------------------------------------------------------------------------------------------
# Providers: choose what powers each stage of the voice pipeline
# ---------------------------------------------------------------------------------------------------
# mock | cartesia
STT_PROVIDER=mock
# mock | openrouter
LLM_PROVIDER=mock
# mock | cartesia
TTS_PROVIDER=mock

# ---------------------------------------------------------------------------------------------------
# Twilio: phone calls (https://console.twilio.com)
# ---------------------------------------------------------------------------------------------------
# Public HTTPS address of the backend. Twilio connects the call audio to {PUBLIC_BASE_URL}/twilio/media.
# Locally, run `ngrok http 8080` and paste the https URL here. Then set your Twilio number's
# "A call comes in" webhook to POST {PUBLIC_BASE_URL}/twilio/voice.
PUBLIC_BASE_URL=http://localhost:8080
# Console → Account info. Needed to transfer calls to a human and to validate webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Reject webhook requests without a valid X-Twilio-Signature. Turn on in production.
TWILIO_VALIDATE_SIGNATURE=false

# ---------------------------------------------------------------------------------------------------
# Cartesia: speech-to-text and text-to-speech (https://play.cartesia.ai → API keys)
# ---------------------------------------------------------------------------------------------------
CARTESIA_API_KEY=
# Pick a voice in the Cartesia playground and copy its ID.
CARTESIA_VOICE_ID=
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_TTS_MODEL=sonic-2
CARTESIA_VERSION=2025-04-16

# ---------------------------------------------------------------------------------------------------
# OpenRouter: the LLM that writes answers (https://openrouter.ai/keys)
# ---------------------------------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Any chat model on OpenRouter. Small, fast models keep turn latency low.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------------------------------
# Your business and knowledge base
# ---------------------------------------------------------------------------------------------------
# YAML with name, greeting, hours, address, handoff number and starter FAQs.
# Use `file:/absolute/path/my-business.yaml` for your own; see backend/src/main/resources/business/demo-clinic.yaml.
BUSINESS_PROFILE=classpath:business/demo-clinic.yaml
# Minimum BM25 score for the agent to answer from an entry. Raise it to answer less often but more safely
# (more questions become knowledge gaps); lower it to answer more loosely.
KNOWLEDGE_MIN_SCORE=2.2

# ---------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------
# By default the backend uses an embedded H2 file in backend/data/. For PostgreSQL, run with
# SPRING_PROFILES_ACTIVE=postgres (Docker Compose does this for you).
# SPRING_PROFILES_ACTIVE=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/calldesk
DATABASE_USERNAME=calldesk
DATABASE_PASSWORD=calldesk

# ---------------------------------------------------------------------------------------------------
# Dashboard access
# ---------------------------------------------------------------------------------------------------
# Extra browser origins allowed to call the API, comma separated (http://localhost:3000 is always allowed).
# Set this to your deployed dashboard URL, for example https://calldesk.vercel.app
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------------------------------
# Conversation tuning (defaults work well; change only if you know why)
# ---------------------------------------------------------------------------------------------------
# Voice activity detection on 8 kHz phone audio: loudness threshold, and how long speech/silence must
# last before a turn starts/ends. Lower VAD_SPEECH_END_MS = snappier replies but more cut-offs.
VAD_ENERGY_THRESHOLD=700
VAD_SPEECH_START_MS=60
VAD_SPEECH_END_MS=500
# Ask "Are you still there?" after this much silence, then hang up.
SILENCE_REPROMPT_AFTER_MS=8000
SILENCE_HANGUP_AFTER_MS=20000
# Start generating a reply once the partial transcript has been stable this long.
EAGER_REPLY_ENABLED=true
EAGER_REPLY_STABLE_PARTIAL_MS=250

# Artificial delays for the mock providers, to make simulated calls behave like real ones.
MOCK_STT_DELAY_MS=0
MOCK_LLM_TOKEN_DELAY_MS=20
MOCK_TTS_FIRST_CHUNK_DELAY_MS=80
