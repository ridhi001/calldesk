# URL of the CallDesk backend as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional: URL the dashboard server uses for server-side rendering, if different (Docker Compose sets http://backend:8080)
CALLDESK_API_INTERNAL_URL=
# Set to true to run the dashboard on built-in sample data (no backend needed). The UI shows a "Demo data" badge.
NEXT_PUBLIC_DEMO_MODE=false
# IANA time zone used to display call times (the business's local time)
NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata
